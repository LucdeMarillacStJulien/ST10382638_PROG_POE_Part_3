@using ST10382638_PROG_POE.Models
@model ApplicationUser

@{
    ViewData["Title"] = "User Details";

    var role = ViewBag.Role as string ?? "";
    var lecturerProfile = ViewBag.LecturerProfile as LecturerProfile;
    var claimSummary = ViewBag.ClaimSummary;
    bool hasClaims = ViewBag.HasClaims is bool b && b;
}

<div class="page-head">
    <div>
        <h1>@Model.FirstName @Model.Surname</h1>
        <p class="page-sub">
            <span class="badge">@(!string.IsNullOrWhiteSpace(role) ? role : "No role")</span>
            • @Model.Email
        </p>
    </div>
</div>

<div class="row g-3">
    <!-- Left: Core user info -->
    <div class="col-lg-6">
        <div class="glass-card p-3">
            <h5 class="mb-2">Account Information</h5>
            <hr class="hr-neon" />

            <dl class="row mb-0">
                <dt class="col-4">User Id</dt>
                <dd class="col-8">@Model.Id</dd>

                <dt class="col-4">User Name</dt>
                <dd class="col-8">@Model.UserName</dd>

                <dt class="col-4">First Name</dt>
                <dd class="col-8">@Model.FirstName</dd>

                <dt class="col-4">Surname</dt>
                <dd class="col-8">@Model.Surname</dd>

                <dt class="col-4">Email</dt>
                <dd class="col-8">@Model.Email</dd>
            </dl>
        </div>
    </div>

    <!-- Right: HR actions -->
    <div class="col-lg-6">
        <div class="glass-card p-3">
            <h5 class="mb-2">Actions</h5>
            <hr class="hr-neon" />

            <div class="d-flex flex-wrap gap-12 mb-2">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline">
                    Edit User
                </a>

                <a asp-action="Index"
                   class="btn btn-outline">
                    Back to List
                </a>
            </div>

            @if (role == "Lecturer" && hasClaims)
            {
                <form asp-action="DownloadReport"
                      method="post"
                      class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-neon btn-neon-details">
                        Download Claim Report (CSV)
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@if (role == "Lecturer" && lecturerProfile != null)
{
    <div class="glass-card p-3 mt-3">
        <h5 class="mb-2">Lecturer Profile</h5>
        <hr class="hr-neon" />

        <div class="row g-3">
            <div class="col-md-4">
                <div class="text-muted small">Lecturer Profile Id</div>
                <div>@lecturerProfile.LecturerProfileId</div>
            </div>

            <div class="col-md-4">
                <div class="text-muted small">Hourly Rate</div>
                <div>R @lecturerProfile.HourlyRate.ToString("0.00")</div>
            </div>

            <div class="col-md-4">
                <div class="text-muted small">Availability</div>
                <span class="badge @(lecturerProfile.IsAvailable ? "badge-accent" : "badge-danger")">
                    @(lecturerProfile.IsAvailable ? "Available" : "Not Available")
                </span>
            </div>

            <div class="col-md-4">
                <div class="text-muted small">Linked User Id</div>
                <div>@lecturerProfile.UserId</div>
            </div>
        </div>

        @if (claimSummary != null)
        {
            var summary = claimSummary; // dynamic from ViewBag

            <hr class="hr-neon mt-3" />
            <h5 class="mb-2">Claim Summary</h5>

            <div class="row g-3">
                <div class="col-md-3">
                    <div class="text-muted small">Total Claims</div>
                    <div class="h4 mb-0">@summary.TotalClaims</div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">Total Hours</div>
                    <div class="h4 mb-0">@summary.TotalHours</div>
                </div>

                <div class="col-md-3">
                    <div class="text-muted small">Total Amount</div>
                    <div class="h4 mb-0">R @summary.TotalAmount</div>
                </div>
            </div>

            @* Optional status breakdown chips *@
            <div class="mt-3">
                <div class="text-muted small mb-1">By Status</div>
                @foreach (var s in summary.StatusBreakdown)
                {
                    <span class="badge me-2 mb-1">
                        @s.Status: @s.Count
                    </span>
                }
            </div>
        }
    </div>
}
