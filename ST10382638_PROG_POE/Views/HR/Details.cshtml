@using ST10382638_PROG_POE.Models
@model ApplicationUser

@{
    ViewData["Title"] = "User Details";

    var role = ViewBag.Role as string ?? "";
    var lecturerProfile = ViewBag.LecturerProfile as LecturerProfile;

    var claims = ViewBag.AllClaims as List<Claim> ?? new List<Claim>();

    double totalHoursAll = 0;
    double totalAmountAll = 0;

    if (ViewBag.TotalHoursAll != null)
    {
        totalHoursAll = (double)ViewBag.TotalHoursAll;
    }
    if (ViewBag.TotalAmountAll != null)
    {
        totalAmountAll = Convert.ToDouble(ViewBag.TotalAmountAll);
    }

    var za = System.Globalization.CultureInfo.CreateSpecificCulture("en-ZA");
}

<div class="page-head">
    <div>
        <h1>@Model.FirstName @Model.Surname</h1>
        <p class="page-sub">
            <span class="badge">@(!string.IsNullOrWhiteSpace(role) ? role : "No role")</span>
            • @Model.Email
        </p>
    </div>
</div>

<div class="row g-3">
    <!-- Left: Core user info -->
    <div class="col-lg-6">
        <div class="glass-card p-3">
            <h5 class="mb-2">Account Information</h5>
            <hr class="hr-neon" />

            <dl class="row mb-0">
                <dt class="col-4">User Id</dt>
                <dd class="col-8">@Model.Id</dd>

                <dt class="col-4">First Name</dt>
                <dd class="col-8">@Model.FirstName</dd>

                <dt class="col-4">Surname</dt>
                <dd class="col-8">@Model.Surname</dd>

                <dt class="col-4">Email</dt>
                <dd class="col-8">@Model.Email</dd>
            </dl>
        </div>
    </div>

    <!-- Right: HR actions -->
    <div class="col-lg-6">
        <div class="glass-card p-3">
            <h5 class="mb-2">Actions</h5>
            <hr class="hr-neon" />

            <div class="d-flex flex-wrap gap-12 mb-2">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline">
                    Edit User
                </a>

                <a asp-action="Index"
                   class="btn btn-outline">
                    Back to List
                </a>
            </div>
        </div>
    </div>
</div>

@if (role.Equals("Lecturer", StringComparison.OrdinalIgnoreCase) && lecturerProfile != null)
{
    <!-- Lecturer profile summary -->
    <div class="glass-card p-3 mt-3">
        <h5 class="mb-2">Lecturer Profile</h5>
        <hr class="hr-neon" />

        <div class="row g-3">
            <div class="col-md-4">
                <div class="text-muted small">Lecturer Profile Id</div>
                <div>@lecturerProfile.LecturerProfileId</div>
            </div>

            <div class="col-md-4">
                <div class="text-muted small">Hourly Rate</div>
                <div>R @lecturerProfile.HourlyRate.ToString("0.00")</div>
            </div>

            <div class="col-md-4">
                <div class="text-muted small">Availability</div>
                <span class="badge @(lecturerProfile.IsAvailable ? "badge-accent" : "badge-danger")">
                    @(lecturerProfile.IsAvailable ? "Available" : "Not Available")
                </span>
            </div>
        </div>
    </div>

    <!-- Claims + invoicing tools -->
    <div class="glass-card p-3 mt-3">
        <h5 class="mb-2">Claims &amp; Invoicing</h5>
        <hr class="hr-neon" />

        @* Period invoice (day / week / month) *@
        @if (TempData["PeriodInvoiceError"] is string periodError && !string.IsNullOrWhiteSpace(periodError))
        {
            <div class="alert alert-warning mb-3">
                @periodError
            </div>
        }
        <form asp-action="DownloadInvoiceByPeriod"
              method="post"
              class="row g-3 align-items-end hover-only-inputs">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="col-md-4">
                <label class="form-label">Period</label>
                <select name="period" class="input-clean form-select">
                    <option value="day">Day</option>
                    <option value="week">Week</option>
                    <option value="month">Month</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Reference Date</label>
                <input type="date"
                       name="referenceDate"
                       class="input-clean form-control" />
            </div>

            <div class="col-md-4">
                <button type="submit" class="btn btn-neon-details w-100">
                    Download Period Invoice (CSV)
                </button>
            </div>
        </form>

        @* Summary for all claims (all statuses) *@
        <div class="row g-3 mt-3">
            <div class="col-md-3">
                <div class="text-muted small">Total Claims</div>
                <div class="h4 mb-0">@claims.Count</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Total Hours</div>
                <div class="h4 mb-0">@totalHoursAll.ToString("0.##", za)</div>
            </div>
            <div class="col-md-3">
                <div class="text-muted small">Total Amount</div>
                <div class="h4 mb-0">R @totalAmountAll.ToString("0.00")</div>
            </div>
        </div>

        <div class="mt-3">
            @if (!claims.Any())
            {
                <div class="text-center py-4">
                    <p class="text-muted mb-0">This lecturer has no claims yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive mt-2">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Claim #</th>
                                <th scope="col" class="text-end">Hours</th>
                                <th scope="col" class="text-end">Rate</th>
                                <th scope="col" class="text-end">Amount</th>
                                <th scope="col" class="text-end">Submitted</th>
                                <th scope="col" class="text-end">Status</th>
                                <th scope="col" class="text-end">Invoice</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in claims)
                            {
                                var claimNo = $"CMC-{c.SubmittedOn:yyyy}-{c.ClaimId:D3}";
                                var amount = c.CalculatedAmount;

                                <tr>
                                    <td class="fw-semibold">@claimNo</td>
                                    <td class="text-end">@c.HoursWorked.ToString("0.##", za)</td>
                                    <td class="text-end">@c.RateAtSubmission.ToString("C", za)</td>
                                    <td class="text-end">@amount.ToString("C", za)</td>
                                    <td class="text-end">@c.SubmittedOn.ToString("dd MMM yyyy")</td>
                                    <td class="text-end">
                                        @{
                                            string badgeClass = c.Status?.Trim().ToLower() switch
                                            {
                                                "pending" => "badge bg-warning text-dark",
                                                "verified" => "badge bg-info text-dark",
                                                "approved" => "badge bg-success text-white",
                                                "rejected" => "badge bg-danger text-white",
                                                _ => "badge bg-secondary text-white"
                                            };
                                        }
                                        <span class="@badgeClass">@c.Status</span>
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="DownloadClaimInvoice"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="claimId" value="@c.ClaimId" />
                                            <button type="submit" class="btn btn-neon-details btn-sm">
                                                Invoice (CSV)
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-dark">
                            <tr>
                                <th colspan="1" class="text-end">Totals:</th>
                                <th class="text-end">@totalHoursAll.ToString("0.##", za)</th>
                                <th></th>
                                <th class="text-end">@totalAmountAll.ToString("C", za)</th>
                                <th colspan="3"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

