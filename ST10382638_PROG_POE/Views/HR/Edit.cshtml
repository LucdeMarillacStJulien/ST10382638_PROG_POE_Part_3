@using ST10382638_PROG_POE.Models
@model ApplicationUser

@{
    ViewData["Title"] = "Edit User";

    // From HRController.Edit GET
    var role = ViewBag.Role as string ?? "";
    var lecturerProfile = ViewBag.LecturerProfile as LecturerProfile;
}

<div class="page-head">
    <h1>Edit User</h1>
    <p class="page-sub">Update user details and lecturer settings (if applicable)</p>
</div>

<div class="glass-card p-3">
    <form asp-action="Edit" method="post" class="hover-only-inputs">
        @Html.AntiForgeryToken()

        @* Needed so the POST can find the existing user *@
        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            @* ---------- Base user details (all roles) ---------- *@
            <div class="col-12">
                <h5 class="mb-2">User Details</h5>
                <hr class="hr-neon" />
            </div>

            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="input-clean" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Surname" class="form-label"></label>
                <input asp-for="Surname" class="input-clean" />
                <span asp-validation-for="Surname" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="input-clean" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            @* ---------- Lecturer-only fields ---------- *@
            @if (role == "Lecturer")
            {
                <div class="col-12 mt-2">
                    <h5 class="mb-2">Lecturer Settings</h5>
                    <hr class="hr-neon" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Hourly Rate</label>
                    <input name="HourlyRate"
                           type="number"
                           step="0.01"
                           class="input-clean"
                           value="@(lecturerProfile != null ? lecturerProfile.HourlyRate.ToString("0.00") : string.Empty)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Availability</label>
                    @{
                        var available = lecturerProfile?.IsAvailable ?? true;
                    }
                    <select name="IsAvailable" class="form-select input-clean">
                        <option value="true" selected="@(available ? "selected" : null)">Available</option>
                        <option value="false" selected="@(available ? null : "selected")">Not Available</option>
                    </select>
                </div>
            }
        </div>

        <div class="d-flex gap-12 mt-16">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-outline">Back</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
