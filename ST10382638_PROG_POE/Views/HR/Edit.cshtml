@using ST10382638_PROG_POE.Models
@model ApplicationUser

@{
    ViewData["Title"] = "Edit User";

    var role = ViewBag.Role as string ?? "";
    var lecturerProfile = ViewBag.LecturerProfile as LecturerProfile;
}

<div class="page-head">
    <h1>Edit User</h1>
    <p class="page-sub">Update user details, password and lecturer hourly rate</p>
</div>

<div class="glass-card p-3">
    <form asp-action="Edit" method="post" class="hover-only-inputs">
        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            @* ---------- User details (all roles) ---------- *@
            <div class="col-12">
                <h5 class="mb-2">User Details</h5>
                <hr class="hr-neon" />
            </div>

            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="input-clean" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Surname" class="form-label"></label>
                <input asp-for="Surname" class="input-clean" />
                <span asp-validation-for="Surname" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="input-clean" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            @* ---------- Password (all roles) ---------- *@
            <div class="col-12 mt-2">
                <h5 class="mb-2">Password</h5>
                <hr class="hr-neon" />
            </div>

            <div class="col-md-6">
                <label class="form-label">New Password</label>
                <input type="password" name="NewPassword" class="input-clean" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Confirm Password</label>
                <input type="password" name="ConfirmPassword" class="input-clean" />
                @Html.ValidationMessage("ConfirmPassword", null, new { @class = "text-danger" })
            </div>

            @* ---------- Lecturer-only hourly rate ---------- *@
            @if (role == "Lecturer")
            {
                <div class="col-12 mt-2">
                    <h5 class="mb-2">Lecturer Settings</h5>
                    <hr class="hr-neon" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Hourly Rate</label>
                    <input name="HourlyRate"
                           type="number"
                           step="0.01"
                           class="input-clean"
                           value="@(lecturerProfile != null ? lecturerProfile.HourlyRate.ToString("0.00") : string.Empty)" />
                </div>
            }
        </div>

        <div class="d-flex gap-12 mt-16">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-outline">Back</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
