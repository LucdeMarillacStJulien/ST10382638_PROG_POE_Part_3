@using ST10382638_PROG_POE.Models
@model ApplicationUser

@{
    ViewData["Title"] = "Create User";
}

<div class="page-head">
    <h1>Create User</h1>
    <p class="page-sub">Add a new Lecturer, Coordinator, Manager or HR user</p>
</div>

<div class="glass-card p-3">
    @* Form posts to HRController.Create (POST) to add a new ApplicationUser *@
    <form asp-action="Create" method="post" class="hover-only-inputs">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            @* ---------- User Details ---------- *@
            <div class="col-12">
                <h5 class="mb-2">User Details</h5>
                <hr class="hr-neon" />
            </div>

            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="input-clean" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Surname" class="form-label"></label>
                <input asp-for="Surname" class="input-clean" />
                <span asp-validation-for="Surname" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="input-clean" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                @* PasswordHash is used as the plain password input in HRController.Create *@
                <label asp-for="PasswordHash" class="form-label">Password</label>
                <input asp-for="PasswordHash" type="password" class="input-clean" />
                <span asp-validation-for="PasswordHash" class="text-danger"></span>
            </div>

            @* ---------- Role & Lecturer Settings ---------- *@
            <div class="col-12 mt-2">
                <h5 class="mb-2">Role & Rate</h5>
                <hr class="hr-neon" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Role</label>
                @* Binds to 'role' parameter on HRController.Create *@
                <select name="role" class="form-select input-clean">
                    <option value="Lecturer">Lecturer</option>
                    <option value="Coordinator">Coordinator</option>
                    <option value="Manager">Manager</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Hourly Rate (Lecturer only)</label>
                @* Optional; only used when role == Lecturer to seed LecturerProfile.HourlyRate *@
                <input name="HourlyRate"
                       type="number"
                       step="0.01"
                       min="10"
                       max="750"
                       class="input-clean"
                       placeholder="e.g. 450.00" />
            </div>
        </div>

        <div class="d-flex gap-12 mt-16">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @* Client-side validation scripts *@
    <partial name="_ValidationScriptsPartial" />
}

