@using ST10382638_PROG_POE.Models
@model LecturerProfile
@{
    ViewData["Title"] = "Tracking Claims";

    // Read-only view data injected by controller for KPIs and table.
    var claims = ViewBag.AllClaims as List<Claim> ?? new List<Claim>();
    var totalPending = (int)(ViewBag.TotalPending ?? 0);
    var totalHours = (double)(ViewBag.TotalHours ?? 0d);
    var totalAmount = Convert.ToDouble(ViewBag.TotalAmount ?? 0d);
    var email = ViewBag.LecturerEmail as string ?? "";

    // Totals across all claims (not only approved) for footer.
    var totalHoursAll = (double)(ViewBag.TotalHoursAll ?? 0d);
    var totalAmountAll = Convert.ToDouble(ViewBag.TotalAmountAll ?? 0d);

    // Culture for ZAR currency formatting.
    var za = System.Globalization.CultureInfo.CreateSpecificCulture("en-ZA");
}

<section class="container py-4">
    @* ---------- Header / Actions ---------- *@
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div class="d-flex align-items-center gap-3">
            <h2 class="m-0">Claim Tracking</h2>
            <span class="badge bg-danger text-white">
                LIVE
            </span>
        </div>

        <div class="d-flex gap-2">
            @* Back navigation to the lecturer dashboard retains email context *@
            <a class="btn btn-outline" asp-controller="Lecturer" asp-action="Index" asp-route-email="@email">Back to Dashboard</a>
        </div>
    </div>

    @* ---------- KPI Summary Cards ---------- *@
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted">Total Pending</div>
                        <div class="fs-4 fw-bold">@totalPending</div>
                    </div>
                    <span class="badge bg-warning text-dark">Pending</span>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted">Total Hours</div>
                        <div class="fs-4 fw-bold">@totalHours</div>
                    </div>
                    <i class="bi bi-clock"></i>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted">Total Amount</div>
                        <div class="fs-4 fw-bold">@totalAmount.ToString("C", za)</div>
                    </div>
                    <i class="bi bi-cash"></i>
                </div>
            </div>
        </div>
    </div>

    @* ---------- Claims Table ---------- *@
    <div class="card mt-3">
        <div class="card-body">
            @if (!claims.Any())
            {
                @* Empty state when no claims exist for the lecturer *@
                <div class="text-center py-5">
                    <p class="text-muted mb-3">You have no pending claims.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Claim #</th>
                                <th scope="col" class="text-end">Hour</th>
                                <th scope="col" class="text-end">Rate</th>
                                <th scope="col" class="text-end">Amount</th>
                                <th scope="col" class="text-end">Submitted</th>
                                <th scope="col" class="text-end">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in claims)
                            {
                                // Display-friendly claim number uses year + identity.
                                var claimNo = $"CMC-{c.SubmittedOn:yyyy}-{c.ClaimId:D3}";
                                var amount = c.CalculatedAmount;

                                <tr>
                                    <td class="fw-semibold">@claimNo</td>
                                    <td class="text-end">@c.HoursWorked.ToString("0.##", za)</td>
                                    <td class="text-end">@c.RateAtSubmission.ToString("C", za)</td>
                                    <td class="text-end">@amount.ToString("C", za)</td>
                                    <td class="text-end">@c.SubmittedOn.ToString("dd MMM yyyy")</td>
                                    <td class="text-end">
                                        @{
                                            // Map normalized status → Bootstrap badge styles
                                            string badgeClass = c.Status?.Trim().ToLower() switch
                                            {
                                                "pending" => "badge bg-warning text-dark",   // Yellow
                                                "verified" => "badge bg-info text-dark",      // Light blue
                                                "approved" => "badge bg-success text-white",  // Green
                                                "rejected" => "badge bg-danger text-white",   // Red
                                                _ => "badge bg-secondary text-white"          // Fallback
                                            };
                                        }
                                        <span class="@badgeClass">@c.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-dark">
                            <tr>
                                @* Footer aggregates: hours & amount across ALL claims *@
                                <th colspan="1" class="text-end">Totals:</th>
                                <th class="text-end">@totalHoursAll</th>
                                <th></th>
                                <th class="text-end">@totalAmountAll.ToString("C", za)</th>
                                <th colspan="3"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</section>

