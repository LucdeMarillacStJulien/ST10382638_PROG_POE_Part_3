@model ST10382638_PROG_POE.Models.Login

@{
    ViewData["Title"] = "Login";
}

<div class="h-100 d-flex justify-content-center align-items-center">
    <div class="col-12 col-md-6 col-lg-4">

        <h1 class="text-center mb-3">Sign in to the CMC Portal</h1>

        <div class="card">
            <div class="card-body">
                @* Displays validation summary for model-level errors *@
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @* Login form posts to Account/Login with anti-forgery protection *@
                <form asp-action="Login" method="post" class="hover-only-inputs">
                    @Html.AntiForgeryToken()

                    @* Email input field *@
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               style="color: var(--text);" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    @* Password input field *@
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               style="color: var(--text);" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    @* Optional "Remember me" checkbox (currently disabled in UI) *@
                    @* <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div> *@

                    @* Submit button to trigger login *@
                    <button type="submit" class="btn btn-primary w-100">
                        Sign In
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Client-side validation scripts for this form *@
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

