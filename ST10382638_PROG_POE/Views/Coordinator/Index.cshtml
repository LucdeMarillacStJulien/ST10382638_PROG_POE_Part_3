   Name: Luc de Marillac St Julien
   Student Number: ST10382638
   Group: 1

   References:
     1) Project outline/instructions: https://chatgpt.com/c/68f2c6ad-b79c-832c-97a1-59b6f53334a9
     2) C# Reference & Tutorials:   https://www.w3schools.com/cs/index.php
   ===================================================================================== *@

@{
    ViewData["Title"] = "Coordinator Dashboard";
    // Dummy data that has been generate by ChatGPT to give a rough idea what the UI could end up looking like in part 2 of the poe
    var pending = ViewBag.PendingClaims as List<Claim> ?? new();
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
    var coordName = ViewBag.CoordinatorName as string ?? "Manager/Coordinator";
    var email = ViewBag.CoordinatorEmail as string ?? "";

    var za = System.Globalization.CultureInfo.CreateSpecificCulture("en-ZA");
}

<section class="container py-4">
    @* ---------- Header / Welcome + pending count badge ---------- *@
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div class="d-flex align-items-center gap-3">
            <h2 class="m-0">Welcome back, @coordName</h2>
            <span class="badge bg-info text-dark">@pendingCount</span>
        </div>
    </div>

    @* ---------- Pending Claims Grid ---------- *@
    <div class="row g-3">
        @if (!pending.Any())
        {
            @* Empty state when there are no items to process *@
            <div class="col-12">
                <div class="card p-3">
                    <p class="m-0">No pending claims right now.</p>
                </div>
            </div>
        }
        else
        {
            @* Render each pending claim as a card with key details and actions *@
            @foreach (var c in pending)
            {
                // Amount prefers stored CalculatedAmount; falls back to Hours × Rate.
                var amount = (c.CalculatedAmount != 0)
                ? Convert.ToDouble(c.CalculatedAmount)
                : (c.HoursWorked * c.RateAtSubmission);

                // Lecturer display name (fallback if relationship not loaded).
                var lecturerName = c.LecturerProfile?.User != null
                ? $"{c.LecturerProfile.User.FirstName} {c.LecturerProfile.User.Surname}"
                : "Unknown Lecturer";

                // Friendly claim number: year + zero-padded id.
                var claimNo = $"CMC-{c.SubmittedOn:yyyy}-{c.ClaimId:D3}";

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 p-3">
                        @* ---- Card header: lecturer name + status badge ---- *@
                        <div class="d-flex align-items-start justify-content-between gap-2 mb-1">
                            <h5 class="card-title m-0">@lecturerName</h5>
                            <span class="badge bg-warning text-dark">@c.Status</span>
                        </div>

                        @* Claim identifier *@
                        <div class="small text-muted">Claim ID</div>
                        <div class="fw-semibold mb-2">@claimNo</div>

                        @* Submission timestamp *@
                        <div>
                            <div class="text-muted">Submitted</div>
                            <div>@c.SubmittedOn.ToString("dd MMM yyyy")</div>
                        </div>

                        @* Rate snapshot captured at submission time *@
                        <div class="mt-2">
                            <div class="text-muted">Rate at Submission</div>
                            <div class="fw-semibold">@c.RateAtSubmission.ToString("C", za)</div>
                        </div>

                        @* Quick stats row: hours and amount *@
                        <div class="row g-2 my-3">
                            <div class="col-6">
                                <div class="text-muted small">Hours Worked</div>
                                <div class="fw-semibold">@c.HoursWorked.ToString("0.##", za)</div>
                            </div>
                            <div class="col-6 text-end">
                                <div class="text-muted small">Amount</div>
                                <div class="fw-semibold">@amount.ToString("C", za)</div>
                            </div>
                        </div>

                        <div class="mt-2">
                            <div class="text-muted">Notes</div>
                            @if (!string.IsNullOrWhiteSpace(c.Notes))
                            {
                                <div class="mt-2">
                                    
                                    <div class="fw-semibold">@c.Notes</div>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted">No Notes</div>
                            }
                        </div>
                        @* Document list (if any) *@
                        <div class="mt-2">
                            <div class="text-muted">Documents</div>
                            @if (c.SupportingDocs != null && c.SupportingDocs.Any())
                            {
                                <ul class="mb-2">
                                    @foreach (var d in c.SupportingDocs)
                                    {
                                        <li>@d.FileName</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="text-muted">No files uploaded</div>
                            }
                        </div>

                        @* ---- Actions: Verify, Download, Reject ---- *@
                        <div class="mt-auto d-flex align-items-center justify-content-between gap-2">
                            @* Verify (Coordinator) -> ClaimController.Verify (POST) *@
                            <form asp-controller="Claim" asp-action="Verify" asp-route-email="@email" method="post" class="m-0">
                                <input type="hidden" name="id" value="@c.ClaimId" />
                                @* Hidden email field included as-is per original markup *@
                                <input type="hidden" name="=email" value="@email" />
                                <button type="submit" class="btn btn-neon btn-neon-approve">Verify</button>
                            </form>

                            @* Download supporting files if present -> ClaimController.DownloadClaimFolder (GET) *@
                            @if (c.SupportingDocs != null && c.SupportingDocs.Any())
                            {
                                <a asp-controller="Claim"
                                   asp-action="DownloadClaimFolder"
                                   asp-route-claimId="@c.ClaimId"
                                   class="btn btn-neon btn-neon-details">
                                    Download Files
                                </a>
                            }

                            @* Reject (Coordinator) -> ClaimController.Reject (POST) *@
                            <form asp-controller="Claim" asp-action="Reject" asp-route-email="@email" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.ClaimId" />
                                <input type="hidden" name="email" value="@email" />
                                <button type="submit" class="btn btn-neon btn-neon-reject">Reject</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>
