﻿
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ST10382638_PROG_POE.styles.css" asp-append-version="true" />

</head>
<body class="neon-grid">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                @{
                    // Default if not logged in or no matching role
                    var brandController = "Home";
                    var brandAction = "Index";

                    if (User.Identity.IsAuthenticated)
                    {
                        if (User.IsInRole("Lecturer"))
                        {
                            brandController = "Lecturer";   // Lecturer main view
                        }
                        else if (User.IsInRole("Coordinator"))
                        {
                            brandController = "Coordinator"; // Coordinator main view
                        }
                        else if (User.IsInRole("Manager"))
                        {
                            brandController = "Manager";     // Manager main view
                        }
                        else if (User.IsInRole("HR"))
                        {
                            brandController = "HR";          // HR main view
                        }
                    }
                }

                <a class="navbar-brand" href="@Url.Action(brandAction, brandController)">
                    CMC Portal
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav"
                        aria-controls="mainNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <!-- LEFT SIDE NAV ITEMS (can be empty, but must exist) -->
                    <ul class="navbar-nav me-auto">
                        @* Example for later:
                        @if (User.IsInRole("Lecturer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Lecturer" asp-action="Index">Dashboard</a>
                            </li>
                        }
        *@
                    </ul>

                    <!-- RIGHT SIDE LOGOUT -->
                    @if (User.Identity.IsAuthenticated)
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="nav-link btn-link border-0 bg-transparent">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>

            </div>
        </nav>
    </header>

    <!-- main MUST be a direct child of body -->
    <main role="main" class="flex-fill">
        <div class="container pb-3">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            &copy; 2025 - Contract Monthly Claim Portal -
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>